@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="card shadow-sm p-5 border-0 mx-auto" style="max-width: 500px;">
        <i class="bi bi-shield-lock-fill text-danger display-1 mb-3"></i>
        <h2 class="fw-bold text-danger">Access Denied</h2>
        <p class="text-muted">You do not have permission to view or manage this resource under your current role.</p>
        <div class="d-flex justify-content-center gap-2 mt-3">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Go Home</a>
            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                <button type="submit" class="btn btn-danger">Switch Account</button>
            </form>
        </div>
    </div>
</div>