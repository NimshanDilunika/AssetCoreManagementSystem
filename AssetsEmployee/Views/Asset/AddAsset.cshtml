@model AssetsEmployee.Models.Asset
@{
    ViewData["Title"] = "Add Asset";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Add New Hardware Asset</h5>
                </div>
                <div class="card-body">
                    <!-- Displays any binding or validation errors -->
                    <div asp-validation-summary="All" class="alert alert-danger" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>

                    <form asp-action="AddAssetItem" method="post">
                        @Html.AntiForgeryToken()

                        <!-- Basic Hardware Identity -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Asset Name <span class="text-danger">*</span></label>
                                <input type="text" name="assetname" value="@Model?.AssetName" class="form-control" required placeholder="e.g., ThinkPad T14" />
                                <span class="text-danger small">@Html.ValidationMessage("AssetName")</span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Serial Number <span class="text-danger">*</span></label>
                                <input type="text" name="serialno" value="@Model?.SerialNo" class="form-control" required placeholder="e.g., L10024" />
                                <span class="text-danger small">@Html.ValidationMessage("SerialNo")</span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <textarea name="description" class="form-control" rows="2" placeholder="Hardware specifications, notes...">@Model?.Description</textarea>
                        </div>

                        <!-- Financials & Straight-Line Depreciation -->
                        <h6 class="border-bottom pb-2 pt-2 text-secondary fw-bold">Financials & Depreciation</h6>
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label">Purchase Date</label>
                                <input type="date" name="purchaseDate" value="@(Model?.PurchaseDate?.ToString("yyyy-MM-dd"))" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Purchase Cost ($)</label>
                                <input type="number" step="0.01" min="0" name="purchaseCost" value="@(Model?.PurchaseCost > 0 ? Model.PurchaseCost.ToString() : "")" class="form-control" placeholder="0.00" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Salvage Floor ($)</label>
                                <input type="number" step="0.01" min="0" name="salvageValue" value="@(Model?.SalvageValue > 0 ? Model.SalvageValue.ToString() : "")" class="form-control" placeholder="0.00" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Useful Lifecycle (Months)</label>
                            <input type="number" name="usefulLifeMonths" value="@(Model?.UsefulLifeMonths > 0 ? Model.UsefulLifeMonths : 36)" class="form-control" />
                            <div class="form-text">Standard enterprise hardware lifespan (default: 36 months).</div>
                        </div>

                        <!-- Manufacturer Warranty -->
                        <h6 class="border-bottom pb-2 pt-2 text-secondary fw-bold">Warranty Details</h6>
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label">Warranty Expiry Date</label>
                                <input type="date" name="warrantyExpiryDate" value="@(Model?.WarrantyExpiryDate?.ToString("yyyy-MM-dd"))" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Warranty Provider / Vendor</label>
                                <input type="text" name="warrantyProvider" value="@Model?.WarrantyProvider" class="form-control" placeholder="e.g., Dell ProSupport, Lenovo Care" />
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary">Save Asset</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>