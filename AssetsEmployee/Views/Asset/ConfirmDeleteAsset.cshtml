@model AssetsEmployee.Models.Asset
@{
    ViewData["Title"] = "Confirm Delete Asset";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0"><i class="bi bi-trash"></i> Confirm Asset Deletion</h4>
            </div>
            <div class="card-body">
                <p class="lead text-danger fw-semibold">Are you sure you want to permanently delete this asset?</p>
                
                <dl class="row mb-0">
                    <dt class="col-sm-4">Asset ID:</dt>
                    <dd class="col-sm-8">@Model.AssetId</dd>

                    <dt class="col-sm-4">Serial No:</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-light text-dark border">@Model.SerialNo</span>
                    </dd>

                    <dt class="col-sm-4">Asset Name:</dt>
                    <dd class="col-sm-8">@Model.AssetName</dd>

                    <dt class="col-sm-4">Description:</dt>
                    <dd class="col-sm-8">@(Model.Description ?? "-")</dd>
                </dl>
            </div>
            <div class="card-footer d-flex justify-content-between">
                <a asp-controller="Asset" asp-action="Index" class="btn btn-secondary">Cancel</a>
                <form asp-controller="Asset" asp-action="DeleteAsset" method="post">
                    <input type="hidden" name="assetid" value="@Model.AssetId" />
                    <button type="submit" class="btn btn-danger">Yes, Delete Asset</button>
                </form>
            </div>
        </div>
    </div>
</div>