@model AssetsEmployee.Models.Department
@{
    ViewData["Title"] = "Confirm Delete Department";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0"><i class="bi bi-trash"></i> Confirm Department Deletion</h4>
            </div>
            <div class="card-body">
                <p class="lead text-danger fw-semibold">Are you sure you want to permanently delete this department?</p>
                
                <dl class="row mb-0">
                    <dt class="col-sm-4">Department ID:</dt>
                    <dd class="col-sm-8">@Model.DepartmentId</dd>

                    <dt class="col-sm-4">Department Name:</dt>
                    <dd class="col-sm-8 fw-bold">@Model.DepartmentName</dd>

                    <dt class="col-sm-4">Location:</dt>
                    <dd class="col-sm-8">@(Model.Location ?? "N/A")</dd>

                    <dt class="col-sm-4">Description:</dt>
                    <dd class="col-sm-8">@(Model.Description ?? "-")</dd>
                </dl>
            </div>
            <div class="card-footer d-flex justify-content-between">
                <a asp-controller="Department" asp-action="Index" class="btn btn-secondary">Cancel</a>
                <form asp-controller="Department" asp-action="DeleteDepartment" method="post">
                    <input type="hidden" name="departmentid" value="@Model.DepartmentId" />
                    <button type="submit" class="btn btn-danger">Yes, Delete Department</button>
                </form>
            </div>
        </div>
    </div>
</div>