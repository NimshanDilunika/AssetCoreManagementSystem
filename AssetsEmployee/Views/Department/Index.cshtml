@model List<AssetsEmployee.Models.Department>
@{
    ViewData["Title"] = "Department Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Department Dashboard</h3>
        <p class="text-muted small mb-0">Overview and management of internal operating departments.</p>
    </div>
    <a asp-controller="Department" asp-action="AddDepartment" class="btn btn-primary btn-sm">
        <i class="bi bi-building-add me-1"></i> Add Department
    </a>
</div>

<!-- Search Bar -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <div class="row">
            <div class="col-md-6 col-lg-5">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" 
                           id="departmentSearchInput" 
                           class="form-control border-start-0 ps-0" 
                           placeholder="Search by ID, name, location..." 
                           onkeyup="filterDepartmentCards()" />
                    <button class="btn btn-outline-secondary" type="button" onclick="clearSearch()">Clear</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Department Cards Grid -->
<div class="row g-3" id="departmentGrid">
    @if (Model == null || !Model.Any())
    {
        <div class="col-12 text-center py-5 text-muted">
            <i class="bi bi-building-slash fs-1 d-block mb-2 text-secondary"></i>
            <p class="mb-0">No departments recorded.</p>
        </div>
    }
    else
    {
        @foreach (var dept in Model)
        {
            <div class="col-md-6 col-xl-4 department-card-wrapper" 
                 data-search="@dept.DepartmentId @dept.DepartmentName @dept.Location @dept.Description">
                <div class="card border-0 shadow-sm rounded-3 h-100">
                    <div class="card-body d-flex flex-column p-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="fw-bold text-dark mb-0">@dept.DepartmentName</h5>
                            <span class="badge bg-light text-secondary border">#@dept.DepartmentId</span>
                        </div>

                        <div class="mb-3">
                            <span class="badge bg-light text-dark border">
                                <i class="bi bi-geo-alt text-danger me-1"></i>@(dept.Location ?? "Location Not Set")
                            </span>
                        </div>

                        <p class="text-muted small flex-grow-1 mb-4">
                            @(string.IsNullOrWhiteSpace(dept.Description) ? "No description provided for this department." : dept.Description)
                        </p>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a asp-controller="Department" 
                               asp-action="DetailDepartment" 
                               asp-route-departmentid="@dept.DepartmentId" 
                               class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-info-circle me-1"></i> Details
                            </a>

                            <div class="d-flex gap-2">
                                <a asp-controller="Department" 
                                   asp-action="UpdateDepartment" 
                                   asp-route-departmentid="@dept.DepartmentId" 
                                   class="btn btn-sm btn-outline-primary" 
                                   title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-controller="Department" 
                                   asp-action="ConfirmDeleteDepartment" 
                                   asp-route-departmentid="@dept.DepartmentId" 
                                   class="btn btn-sm btn-outline-danger" 
                                   title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

<!-- Fallback message for empty search results -->
<div id="noResultsMsg" class="text-center py-5 text-muted d-none">
    <i class="bi bi-search fs-2 d-block mb-2 text-secondary"></i>
    <p class="mb-0">No departments match your search criteria.</p>
</div>

@section Scripts {
    <script>
        function filterDepartmentCards() {
            const query = document.getElementById("departmentSearchInput").value.toLowerCase().trim();
            const cards = document.querySelectorAll(".department-card-wrapper");
            const noResults = document.getElementById("noResultsMsg");
            let visibleCount = 0;

            cards.forEach(card => {
                const searchData = (card.getAttribute("data-search") || "").toLowerCase();
                if (searchData.includes(query)) {
                    card.classList.remove("d-none");
                    visibleCount++;
                } else {
                    card.classList.add("d-none");
                }
            });

            if (visibleCount === 0 && cards.length > 0) {
                noResults.classList.remove("d-none");
            } else {
                noResults.classList.add("d-none");
            }
        }

        function clearSearch() {
            const input = document.getElementById("departmentSearchInput");
            input.value = "";
            filterDepartmentCards();
            input.focus();
        }
    </script>
}