@model AssetsEmployee.Models.Department
@{
    ViewData["Title"] = "Edit Department";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0">Edit Department Details</h5>
            </div>
            <div class="card-body p-4">
                <form asp-controller="Department" asp-action="UpdateDepartmentItem" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="departmentid" value="@Model.DepartmentId" />

                    <div class="mb-3">
                        <label for="departmentname" class="form-label fw-semibold">Department Name</label>
                        <input type="text" 
                               value="@Model.DepartmentName" 
                               name="departmentname" 
                               class="form-control" 
                               id="departmentname" 
                               placeholder="Enter Department Name" 
                               required />
                        <span class="text-danger small">@Html.ValidationMessage("DepartmentName")</span>
                    </div>

                    <div class="mb-3">
                        <label for="location" class="form-label fw-semibold">Location / Office</label>
                        <input type="text" 
                               value="@Model.Location" 
                               name="location" 
                               class="form-control" 
                               id="location" 
                               placeholder="e.g. Building A - Floor 2" 
                               required />
                        <span class="text-danger small">@Html.ValidationMessage("Location")</span>
                    </div>

                    <div class="mb-3">
                        <label for="description" class="form-label fw-semibold">Description</label>
                        <textarea name="description" 
                                  class="form-control" 
                                  id="description" 
                                  rows="3" 
                                  placeholder="Provide department duties or notes">@Model.Description</textarea>
                        <span class="text-danger small">@Html.ValidationMessage("Description")</span>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-controller="Department" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">Update Department</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>