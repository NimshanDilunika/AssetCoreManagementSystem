@model List<AssetsEmployee.Models.EmployeeAsset>
@{
    ViewData["Title"] = "Employee Detail Dashboard";
}

<div class="container py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h2 fw-bold text-primary mb-1">Employee Detail Dashboard</h1>
            <p class="text-muted mb-0">Overview of assigned assets and history</p>
        </div>
        <div>
            <!-- Optional Back Button -->
            <a asp-controller="Employee" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Back to Employees
            </a>
        </div>
    </div>

    <!-- Employee Info Card -->
    <div class="card shadow-sm mb-4">
        <div class="card-body bg-light rounded">
            <h5 class="card-subtitle text-muted text-uppercase fs-7 fw-bold mb-1">Employee Name</h5>
            <h3 class="card-title text-dark mb-0 fw-semibold">
                @(Model.FirstOrDefault()?.Employee?.EmployeeName ?? "Unknown Employee")
            </h3>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="card-title mb-0 fw-bold text-secondary">Assigned Assets History</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase fs-7">
                    <tr>
                        <th class="ps-4" style="width: 10%;">ID</th>
                        <th style="width: 40%;">Type / Serial No</th>
                        <th style="width: 25%;">Assigned Date</th>
                        <th style="width: 25%;">Unassigned Date</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox display-6 d-block mb-2"></i>
                                No assignments available for this employee.
                            </td>
                        </tr>    
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-secondary">#@item.Id</td>
                                <td>
                                    <span class="fw-bold text-dark">@(item.Asset?.AssetName ?? "N/A")</span>
                                    <small class="text-muted d-block fs-7">
                                        SN: <code class="text-secondary">@(item.Asset?.SerialNo ?? "N/A")</code>
                                    </small>
                                </td>
                                <td>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                        @(item.AssignedDate?.ToString("yyyy-MM-dd HH:mm") ?? "-")
                                    </span>
                                </td>
                                <td>
                                    @if (item.UnAssignedDate.HasValue)
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                            @item.UnAssignedDate.Value.ToString("yyyy-MM-dd HH:mm")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                            Currently Active
                                        </span>
                                    }
                                </td>
                            </tr>
                        }   
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>