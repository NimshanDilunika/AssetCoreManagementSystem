@model AssetsEmployee.Models.EmployeeAsset
@{
    ViewData["Title"] = "Confirm Delete";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0"><i class="bi bi-trash"></i> Confirm Deletion</h4>
            </div>
            <div class="card-body">
                <p class="lead text-danger font-weight-bold">Are you sure you want to permanently delete this assignment record?</p>
                
                <dl class="row mb-0">
                    <dt class="col-sm-4">Serial Number:</dt>
                    <dd class="col-sm-8">@(Model.Asset?.SerialNo ?? "N/A")</dd>

                    <dt class="col-sm-4">Asset Name:</dt>
                    <dd class="col-sm-8">@(Model.Asset?.AssetName ?? "N/A")</dd>

                    <dt class="col-sm-4">Employee:</dt>
                    <dd class="col-sm-8">@(Model.Employee?.EmployeeName ?? "N/A")</dd>

                    <dt class="col-sm-4">Assigned Date:</dt>
                    <dd class="col-sm-8">@(Model.AssignedDate?.ToString("yyyy-MM-dd HH:mm") ?? "-")</dd>
                </dl>
            </div>
            <div class="card-footer d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                <form asp-action="DeleteEmployeeAsset" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-danger">Yes, Delete Permanently</button>
                </form>
            </div>
        </div>
    </div>
</div>