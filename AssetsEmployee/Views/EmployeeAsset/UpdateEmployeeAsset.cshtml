@model AssetsEmployee.Models.EmployeeAsset
@{
    ViewData["Title"] = "Edit Assignment";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0">Edit Asset Assignment</h5>
            </div>
            <div class="card-body p-4">
                <form asp-controller="EmployeeAsset" asp-action="UpdateEmployeeAssetItem" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="mb-3">
                        <label for="assetid" class="form-label fw-semibold">Asset (Serial No)</label>
                        <select name="assetid" class="form-select" id="assetid" required>
                            <option value="">-- Select Serial No --</option>
                            @if (ViewBag.Assets != null)
                            {
                                foreach (var asset in ViewBag.Assets)
                                {
                                    if (asset.AssetId == Model.AssetId)
                                    {
                                        <option value="@asset.AssetId" selected>@asset.SerialNo - @asset.AssetName (Currently Assigned)</option>
                                    }
                                    else
                                    {
                                        <option value="@asset.AssetId">@asset.SerialNo - @asset.AssetName</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="employeeid" class="form-label fw-semibold">Assign To Employee</label>
                        <select name="employeeid" class="form-select" id="employeeid" required>
                            <option value="">-- Select Employee --</option>
                            @if (ViewBag.Employees != null)
                            {
                                foreach (var emp in ViewBag.Employees)
                                {
                                    if (emp.EmployeeId == Model.EmployeeId)
                                    {
                                        <option value="@emp.EmployeeId" selected>@emp.EmployeeName</option>
                                    }
                                    else
                                    {
                                        <option value="@emp.EmployeeId">@emp.EmployeeName</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="assigneddate" class="form-label fw-semibold">Assigned Date</label>
                        <input type="datetime-local" 
                               name="assigneddate" 
                               class="form-control" 
                               id="assigneddate" 
                               value="@(Model.AssignedDate?.ToString("yyyy-MM-ddTHH:mm"))" 
                               required />
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-controller="EmployeeAsset" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">Update Record</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>