@model AssetsEmployee.Models.DashboardViewModel
@{
    ViewData["Title"] = "System Analytics Dashboard";
}

<div class="mb-4">
    <h2 class="fw-bold mb-1">System Overview & Analytics</h2>
    <p class="text-muted small mb-0">Read-only operational performance and inventory analytics.</p>
</div>

<!-- Key Metric Counters -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-3">
                <div class="text-muted small fw-bold text-uppercase">Total Inventory</div>
                <div class="fs-3 fw-bold text-dark mt-1">@Model.TotalAssets</div>
                <div class="text-secondary small mt-1"><i class="bi bi-box-seam me-1"></i>Registered Assets</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-3">
                <div class="text-muted small fw-bold text-uppercase">Active Assignments</div>
                <div class="fs-3 fw-bold text-primary mt-1">@Model.AssignedAssets</div>
                <div class="text-secondary small mt-1"><i class="bi bi-person-check me-1"></i>In Custody</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-3">
                <div class="text-muted small fw-bold text-uppercase">Available Stock</div>
                <div class="fs-3 fw-bold text-success mt-1">@Model.AvailableAssets</div>
                <div class="text-secondary small mt-1"><i class="bi bi-check-circle me-1"></i>Ready for Deployment</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-3">
                <div class="text-muted small fw-bold text-uppercase">Pending Tickets</div>
                <div class="fs-3 fw-bold text-warning mt-1">@Model.PendingRequestsCount</div>
                <div class="text-secondary small mt-1"><i class="bi bi-clock-history me-1"></i>Awaiting Review</div>
            </div>
        </div>
    </div>
</div>

<!-- Analytical Charts -->
<div class="row g-4 mb-4">
    <!-- Donut Chart: Inventory Status Breakdown -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="card-title fw-bold mb-0 text-secondary">Asset Status Distribution</h6>
            </div>
            <div class="card-body d-flex justify-content-center align-items-center" style="min-height: 280px;">
                <canvas id="statusDonutChart" style="max-height: 260px;"></canvas>
            </div>
        </div>
    </div>

    <!-- Bar Chart: Inventory Categories -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="card-title fw-bold mb-0 text-secondary">Top Asset Categories by Volume</h6>
            </div>
            <div class="card-body" style="min-height: 280px;">
                <canvas id="categoryBarChart" style="max-height: 260px;"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Read-Only Operational Summary -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-white border-bottom py-3">
        <h6 class="card-title fw-bold mb-0 text-secondary">Recent Requests Overview</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Ticket ID</th>
                        <th>Employee</th>
                        <th>Requested Item</th>
                        <th>Date Submitted</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentRequests == null || !Model.RecentRequests.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted small">No request records recorded.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.RecentRequests)
                        {
                            <tr>
                                <td class="fw-semibold text-muted">#@item.RequestId</td>
                                <td>@(item.Employee?.EmployeeName ?? "N/A")</td>
                                <td><span class="badge bg-light text-dark border">@item.RequestedCategory</span></td>
                                <td class="text-muted small">@item.RequestDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case AssetsEmployee.Models.RequestStatus.Pending:
                                            <span class="badge bg-warning text-dark">Pending</span>
                                            break;
                                        case AssetsEmployee.Models.RequestStatus.Fulfilled:
                                        case AssetsEmployee.Models.RequestStatus.Approved:
                                            <span class="badge bg-success">Approved</span>
                                            break;
                                        case AssetsEmployee.Models.RequestStatus.Rejected:
                                            <span class="badge bg-danger">Rejected</span>
                                            break;
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Status Distribution (Donut Chart)
        const donutCtx = document.getElementById('statusDonutChart').getContext('2d');
        new Chart(donutCtx, {
            type: 'doughnut',
            data: {
                labels: ['Available', 'Assigned', 'Other/Maintenance'],
                datasets: [{
                    data: [@Model.StatusAvailableCount, @Model.StatusAssignedCount, @Model.StatusOtherCount],
                    backgroundColor: ['#198754', '#0d6efd', '#6c757d'],
                    borderWidth: 2,
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom' }
                }
            }
        });

        // Category Distribution (Bar Chart)
        const barCtx = document.getElementById('categoryBarChart').getContext('2d');
        new Chart(barCtx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryNames)),
                datasets: [{
                    label: 'Asset Units',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryCounts)),
                    backgroundColor: '#0d6efd',
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1 }
                    }
                },
                plugins: {
                    legend: { display: false }
                }
            }
        });
    </script>
}