@model AssetsEmployee.Models.MaintenanceRecord
@{
    ViewData["Title"] = "Confirm Delete Ticket";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0"><i class="bi bi-trash-fill me-2"></i>Confirm Maintenance Ticket Deletion</h4>
            </div>
            <div class="card-body">
                <p class="lead text-danger fw-semibold">Are you sure you want to permanently delete this maintenance ticket?</p>

                <dl class="row mb-0">
                    <dt class="col-sm-4">Ticket ID:</dt>
                    <dd class="col-sm-8">#@Model.MaintenanceId</dd>

                    <dt class="col-sm-4">Title:</dt>
                    <dd class="col-sm-8 fw-bold">@Model.Title</dd>

                   <dt class="col-sm-4">Asset:</dt>
                   <dd class="col-sm-8">
                        @(Model.Asset != null ? $"{Model.Asset.SerialNo} - {Model.Asset.AssetName}" : "N/A")
                   </dd>

                    <dt class="col-sm-4">Status:</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-secondary">@Model.Status</span>
                    </dd>

                    <dt class="col-sm-4">Vendor:</dt>
                    <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.ServiceVendor) ? "In-House" : Model.ServiceVendor)</dd>
                </dl>
            </div>
            <div class="card-footer d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                <form asp-action="DeleteMaintenance" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="maintenanceid" value="@Model.MaintenanceId" />
                    <button type="submit" class="btn btn-danger">Yes, Delete Ticket</button>
                </form>
            </div>
        </div>
    </div>
</div>