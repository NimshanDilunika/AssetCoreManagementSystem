@model AssetsEmployee.Models.MaintenanceRecord
@{
    ViewData["Title"] = "Edit Maintenance";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0">Edit Maintenance Details</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="UpdateMaintenance" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="MaintenanceId" />

                    <div class="mb-3">
                        <label asp-for="AssetId" class="form-label fw-semibold">Target Asset</label>
                        <select asp-for="AssetId" asp-items="ViewBag.Assets" class="form-select" required></select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Issue Title</label>
                        <input asp-for="Title" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Detailed Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3" required></textarea>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label asp-for="ServiceVendor" class="form-label fw-semibold">Vendor / Service Shop</label>
                            <input asp-for="ServiceVendor" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Cost" class="form-label fw-semibold">Actual Cost ($)</label>
                            <input asp-for="Cost" type="number" step="0.01" class="form-control" required />
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-semibold">Status</label>
                            <select asp-for="Status" class="form-select" required>
                                <option value="Scheduled">Scheduled</option>
                                <option value="InProgress">InProgress</option>
                                <option value="Completed">Completed</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CompletedDate" class="form-label fw-semibold">Completed Date</label>
                            <input asp-for="CompletedDate" type="date" class="form-control" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">Update Ticket</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>