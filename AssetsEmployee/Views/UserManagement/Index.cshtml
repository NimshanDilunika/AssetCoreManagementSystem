@model IEnumerable<AssetsEmployee.Models.User>
@{
    ViewData["Title"] = "User Accounts";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">System Users</h3>
        <p class="text-muted small mb-0">Manage internal login accounts, roles, and lockout status.</p>
    </div>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-person-plus-fill me-1"></i> Add New User
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2">@TempData["Error"]</div>
}

<!-- Search Bar -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <div class="row">
            <div class="col-md-6 col-lg-5">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" 
                           id="userSearchInput" 
                           class="form-control border-start-0 ps-0" 
                           placeholder="Search by ID, username, role, or status..." 
                           onkeyup="filterUserCards()" />
                    <button class="btn btn-outline-secondary" type="button" onclick="clearSearch()">Clear</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- User Cards Grid -->
<div class="row g-3" id="userGrid">
    @if (Model == null || !Model.Any())
    {
        <div class="col-12 text-center py-5 text-muted">
            <i class="bi bi-people fs-1 d-block mb-2 text-secondary"></i>
            <p class="mb-0">No users found.</p>
        </div>
    }
    else
    {
        @foreach (var u in Model)
        {
            var isLocked = u.LockoutEnd.HasValue && u.LockoutEnd.Value > DateTime.UtcNow;
            var statusText = isLocked ? "Locked Out" : "Active";

            <div class="col-md-6 col-xl-4 user-card-wrapper" 
                 data-search="@u.UserId @u.Username @u.Role @statusText">
                <div class="card border-0 shadow-sm rounded-3 h-100">
                    <div class="card-body d-flex flex-column p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h5 class="fw-bold text-dark mb-1">@u.Username</h5>
                                <span class="badge bg-light text-secondary border">#@u.UserId</span>
                            </div>
                            <span class="badge @(u.Role == "Admin" ? "bg-primary" : "bg-secondary")">
                                @u.Role
                            </span>
                        </div>

                        <div class="mb-4">
                            <span class="text-muted small d-block mb-1">Account Status</span>
                            @if (isLocked)
                            {
                                <span class="badge bg-danger">
                                    <i class="bi bi-lock-fill me-1"></i> Locked Out
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle me-1"></i> Active
                                </span>
                            }
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-3 border-top mt-auto">
                            <a asp-action="Edit" asp-route-id="@u.UserId" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-pencil me-1"></i> Update
                            </a>
                            <a asp-action="ConfirmDeleteUser" asp-route-userid="@u.UserId" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash me-1"></i> Delete
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

<!-- Fallback message for empty search results -->
<div id="noResultsMsg" class="text-center py-5 text-muted d-none">
    <i class="bi bi-search fs-2 d-block mb-2 text-secondary"></i>
    <p class="mb-0">No user accounts match your search criteria.</p>
</div>

@section Scripts {
    <script>
        function filterUserCards() {
            const query = document.getElementById("userSearchInput").value.toLowerCase().trim();
            const cards = document.querySelectorAll(".user-card-wrapper");
            const noResults = document.getElementById("noResultsMsg");
            let visibleCount = 0;

            cards.forEach(card => {
                const searchData = (card.getAttribute("data-search") || "").toLowerCase();
                if (searchData.includes(query)) {
                    card.classList.remove("d-none");
                    visibleCount++;
                } else {
                    card.classList.add("d-none");
                }
            });

            if (visibleCount === 0 && cards.length > 0) {
                noResults.classList.remove("d-none");
            } else {
                noResults.classList.add("d-none");
            }
        }

        function clearSearch() {
            const input = document.getElementById("userSearchInput");
            input.value = "";
            filterUserCards();
            input.focus();
        }
    </script>
}